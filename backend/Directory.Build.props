<Project>

  <!-- Conventions shared by every project in the Even solution.
       Each individual .csproj only declares what's specific to it
       (SDK type, packages, references). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Off for now; turn on when the team is ready to treat every warning as an error. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
