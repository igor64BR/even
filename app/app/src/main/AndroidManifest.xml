<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- T12 — POST /auth/google (T11) and Credential Manager need network access. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".RateioApplication"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Rateio">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- T22.1 — "join group via link": rateio://join/{code}, shareable through any
                 channel (WhatsApp, SMS, etc.), not an integration with anything specific. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="rateio"
                    android:host="join" />
            </intent-filter>
        </activity>

    </application>

</manifest>
